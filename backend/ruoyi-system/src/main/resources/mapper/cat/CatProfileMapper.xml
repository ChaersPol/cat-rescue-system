<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatProfileMapper">

    <resultMap type="CatProfile" id="CatProfileResult">
        <result property="catId" column="cat_id" />
        <result property="archiveNo" column="archive_no" />
        <result property="catName" column="cat_name" />
        <result property="alias" column="alias" />
        <result property="breed" column="breed" />
        <result property="sex" column="sex" />
        <result property="ageEstimate" column="age_estimate" />
        <result property="weight" column="weight" />
        <result property="personality" column="personality" />
        <result property="source" column="source" />
        <result property="captureDate" column="capture_date" />
        <result property="capturePoint" column="capture_point" />
        <result property="neutered" column="neutered" />
        <result property="dewormed" column="dewormed" />
        <result property="vaccinated" column="vaccinated" />
        <result property="feature" column="feature" />
        <result property="status" column="status" />
        <result property="baseId" column="base_id" />
        <result property="wardId" column="ward_id" />
        <result property="ownerBaseId" column="owner_base_id" />
        <result property="hospitalName" column="hospital_name" />
        <result property="qrCode" column="qr_code" />
        <result property="archived" column="archived" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatProfileVo">
        select cat_id, archive_no, cat_name, alias, breed, sex, age_estimate, weight, personality, source, capture_date, capture_point, neutered, dewormed, vaccinated, feature, status, base_id, ward_id, owner_base_id, hospital_name, qr_code, archived, create_by, create_time, update_by, update_time, remark from cat_profile
    </sql>

    <!-- 列表查询不返回 Base64 二维码，避免列表接口数据过大 -->
    <sql id="selectCatProfileListVo">
        select cat_id, archive_no, cat_name, alias, breed, sex, age_estimate, weight, personality, source, capture_date, capture_point, neutered, dewormed, vaccinated, feature, status, base_id, ward_id, owner_base_id, hospital_name, archived, create_by, create_time, update_by, update_time, remark from cat_profile
    </sql>

    <select id="selectCatProfileById" parameterType="Long" resultMap="CatProfileResult">
        <include refid="selectCatProfileVo"/>
        where cat_id = #{catId}
    </select>

    <select id="selectByArchiveNo" parameterType="String" resultMap="CatProfileResult">
        <include refid="selectCatProfileListVo"/>
        where archive_no = #{archiveNo} limit 1
    </select>

    <select id="selectTagNamesByCatId" parameterType="Long" resultType="String">
        select t.tag_name from cat_tag t
        inner join cat_profile_tag pt on pt.tag_id = t.tag_id
        where pt.cat_id = #{catId}
        order by t.tag_id
    </select>

    <select id="selectTagIdsByCatId" parameterType="Long" resultType="Long">
        select tag_id from cat_profile_tag where cat_id = #{catId} order by tag_id
    </select>

    <select id="selectQrCodeByIds" resultMap="CatProfileResult">
        select cat_id, archive_no, cat_name, qr_code from cat_profile
        where del_flag = '0' and cat_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <update id="updateArchived">
        update cat_profile set archived = #{archived}, update_time = sysdate() where cat_id = #{catId}
    </update>

    <select id="selectCatProfileList" parameterType="CatProfile" resultMap="CatProfileResult">
        <include refid="selectCatProfileListVo"/>
        <where>
            <if test="archiveNo != null and archiveNo != ''">AND archive_no like concat('%', #{archiveNo}, '%')</if>
            <if test="catName != null and catName != ''">AND cat_name like concat('%', #{catName}, '%')</if>
            <if test="alias != null and alias != ''">AND alias like concat('%', #{alias}, '%')</if>
            <if test="breed != null and breed != ''">AND breed = #{breed}</if>
            <if test="sex != null and sex != ''">AND sex = #{sex}</if>
            <if test="ageEstimate != null and ageEstimate != ''">AND age_estimate = #{ageEstimate}</if>
            <if test="weight != null and weight != ''">AND weight = #{weight}</if>
            <if test="personality != null and personality != ''">AND personality = #{personality}</if>
            <if test="source != null and source != ''">AND source = #{source}</if>
            <if test="captureDate != null">AND capture_date = #{captureDate}</if>
            <if test="capturePoint != null and capturePoint != ''">AND capture_point like concat('%', #{capturePoint}, '%')</if>
            <if test="neutered != null and neutered != ''">AND neutered = #{neutered}</if>
            <if test="dewormed != null and dewormed != ''">AND dewormed = #{dewormed}</if>
            <if test="vaccinated != null and vaccinated != ''">AND vaccinated = #{vaccinated}</if>
            <if test="feature != null and feature != ''">AND feature like concat('%', #{feature}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="baseId != null">AND base_id = #{baseId}</if>
            <if test="wardId != null">AND ward_id = #{wardId}</if>
            <!-- 助理按病房授权范围过滤；未授权任何病房时不可见任何档案 -->
            <if test="wardScope != null and wardScope">
                <choose>
                    <when test="wardIds != null and wardIds.length > 0">
                        AND ward_id IN
                        <foreach item="wid" collection="wardIds" open="(" separator="," close=")">#{wid}</foreach>
                    </when>
                    <otherwise>AND 1 = 0</otherwise>
                </choose>
            </if>
            <if test="ownerBaseId != null">AND owner_base_id = #{ownerBaseId}</if>
            <if test="hospitalName != null and hospitalName != ''">AND hospital_name = #{hospitalName}</if>
            <if test="archived != null and archived != ''">AND archived = #{archived}</if>
            <if test="tagIds != null and tagIds.length > 0">
                <!-- 数组的 length 只能用 OGNL（bind）取值，#{tagIds.length} 会因 MyBatis 反射不到 length 属性而报错 -->
                <bind name="tagSize" value="tagIds.length" />
                AND cat_id IN (
                    SELECT cat_id FROM cat_profile_tag WHERE tag_id IN
                    <foreach item="tagId" collection="tagIds" open="(" separator="," close=")">#{tagId}</foreach>
                    GROUP BY cat_id HAVING COUNT(DISTINCT tag_id) = #{tagSize}
                )
            </if>
            AND del_flag = '0'
        </where>
        order by cat_id desc
    </select>

    <insert id="insertCatProfile" parameterType="CatProfile" useGeneratedKeys="true" keyProperty="catId">
        insert into cat_profile (
            <if test="archiveNo != null">archive_no,</if>
            <if test="catName != null">cat_name,</if>
            <if test="alias != null">alias,</if>
            <if test="breed != null">breed,</if>
            <if test="sex != null">sex,</if>
            <if test="ageEstimate != null">age_estimate,</if>
            <if test="weight != null">weight,</if>
            <if test="personality != null">personality,</if>
            <if test="source != null">source,</if>
            <if test="captureDate != null">capture_date,</if>
            <if test="capturePoint != null">capture_point,</if>
            <if test="neutered != null">neutered,</if>
            <if test="dewormed != null">dewormed,</if>
            <if test="vaccinated != null">vaccinated,</if>
            <if test="feature != null">feature,</if>
            <if test="status != null">status,</if>
            <if test="baseId != null">base_id,</if>
            <if test="wardId != null">ward_id,</if>
            <if test="ownerBaseId != null">owner_base_id,</if>
            <if test="hospitalName != null">hospital_name,</if>
            <if test="qrCode != null">qr_code,</if>
            <if test="archived != null">archived,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="archiveNo != null">#{archiveNo},</if>
            <if test="catName != null">#{catName},</if>
            <if test="alias != null">#{alias},</if>
            <if test="breed != null">#{breed},</if>
            <if test="sex != null">#{sex},</if>
            <if test="ageEstimate != null">#{ageEstimate},</if>
            <if test="weight != null">#{weight},</if>
            <if test="personality != null">#{personality},</if>
            <if test="source != null">#{source},</if>
            <if test="captureDate != null">#{captureDate},</if>
            <if test="capturePoint != null">#{capturePoint},</if>
            <if test="neutered != null">#{neutered},</if>
            <if test="dewormed != null">#{dewormed},</if>
            <if test="vaccinated != null">#{vaccinated},</if>
            <if test="feature != null">#{feature},</if>
            <if test="status != null">#{status},</if>
            <if test="baseId != null">#{baseId},</if>
            <if test="wardId != null">#{wardId},</if>
            <if test="ownerBaseId != null">#{ownerBaseId},</if>
            <if test="hospitalName != null">#{hospitalName},</if>
            <if test="qrCode != null">#{qrCode},</if>
            <if test="archived != null">#{archived},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatProfile" parameterType="CatProfile">
        update cat_profile
        <set>
            <if test="archiveNo != null and archiveNo != ''">archive_no = #{archiveNo},</if>
            <if test="catName != null and catName != ''">cat_name = #{catName},</if>
            <if test="alias != null and alias != ''">alias = #{alias},</if>
            <if test="breed != null and breed != ''">breed = #{breed},</if>
            <if test="sex != null and sex != ''">sex = #{sex},</if>
            <if test="ageEstimate != null and ageEstimate != ''">age_estimate = #{ageEstimate},</if>
            <if test="weight != null and weight != ''">weight = #{weight},</if>
            <if test="personality != null and personality != ''">personality = #{personality},</if>
            <if test="source != null and source != ''">source = #{source},</if>
            <if test="captureDate != null">capture_date = #{captureDate},</if>
            <if test="capturePoint != null and capturePoint != ''">capture_point = #{capturePoint},</if>
            <if test="neutered != null and neutered != ''">neutered = #{neutered},</if>
            <if test="dewormed != null and dewormed != ''">dewormed = #{dewormed},</if>
            <if test="vaccinated != null and vaccinated != ''">vaccinated = #{vaccinated},</if>
            <if test="feature != null and feature != ''">feature = #{feature},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="baseId != null">base_id = #{baseId},</if>
            <if test="wardId != null">ward_id = #{wardId},</if>
            <if test="ownerBaseId != null">owner_base_id = #{ownerBaseId},</if>
            <if test="hospitalName != null and hospitalName != ''">hospital_name = #{hospitalName},</if>
            <if test="qrCode != null and qrCode != ''">qr_code = #{qrCode},</if>
            <if test="archived != null and archived != ''">archived = #{archived},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where cat_id = #{catId}
    </update>

    <delete id="deleteCatProfileById" parameterType="Long">
        update cat_profile set del_flag = '2' where cat_id = #{catId}
    </delete>

    <delete id="deleteCatProfileByIds" parameterType="Long">
        update cat_profile set del_flag = '2' where cat_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <update id="archiveCatProfile" parameterType="Long">
        update cat_profile set archived = '1', update_time = sysdate() where cat_id = #{catId}
    </update>

    <delete id="deleteCatTagByCatId" parameterType="Long">
        delete from cat_profile_tag where cat_id = #{catId}
    </delete>

    <insert id="batchCatTag">
        insert into cat_profile_tag(cat_id, tag_id) values
        <foreach item="tagId" collection="tagIds" separator=",">
            (#{catId}, #{tagId})
        </foreach>
    </insert>

    <update id="clearCatWard" parameterType="Long">
        update cat_profile set ward_id = null, update_time = sysdate() where cat_id = #{catId}
    </update>

    <update id="clearCatLocation" parameterType="Long">
        update cat_profile set base_id = null, ward_id = null, update_time = sysdate() where cat_id = #{catId}
    </update>

    <update id="clearCatHospital" parameterType="Long">
        update cat_profile set hospital_name = '', update_time = sysdate() where cat_id = #{catId}
    </update>
</mapper>
