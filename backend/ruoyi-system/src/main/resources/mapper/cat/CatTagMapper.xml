<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatTagMapper">

    <resultMap type="CatTag" id="CatTagResult">
        <result property="tagId" column="tag_id" />
        <result property="tagName" column="tag_name" />
        <result property="tagGroup" column="tag_group" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatTagVo">
        select tag_id, tag_name, tag_group, status, create_by, create_time, update_by, update_time, remark from cat_tag
    </sql>

    <select id="selectCatTagById" parameterType="Long" resultMap="CatTagResult">
        <include refid="selectCatTagVo"/>
        where tag_id = #{tagId}
    </select>

    <select id="selectCatTagList" parameterType="CatTag" resultMap="CatTagResult">
        <include refid="selectCatTagVo"/>
        <where>
            <if test="tagName != null and tagName != ''">AND tag_name = #{tagName}</if>
            <if test="tagGroup != null and tagGroup != ''">AND tag_group = #{tagGroup}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            AND del_flag = '0'
        </where>
        order by tag_id desc
    </select>

    <insert id="insertCatTag" parameterType="CatTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into cat_tag (
            <if test="tagName != null">tag_name,</if>
            <if test="tagGroup != null">tag_group,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="tagName != null">#{tagName},</if>
            <if test="tagGroup != null">#{tagGroup},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatTag" parameterType="CatTag">
        update cat_tag
        <set>
            <if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
            <if test="tagGroup != null and tagGroup != ''">tag_group = #{tagGroup},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where tag_id = #{tagId}
    </update>

    <delete id="deleteCatTagById" parameterType="Long">
        update cat_tag set del_flag = '2' where tag_id = #{tagId}
    </delete>

    <delete id="deleteCatTagByIds" parameterType="Long">
        update cat_tag set del_flag = '2' where tag_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
