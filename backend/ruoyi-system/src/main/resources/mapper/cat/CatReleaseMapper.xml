<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatReleaseMapper">

    <resultMap type="CatRelease" id="CatReleaseResult">
        <result property="releaseId" column="release_id" />
        <result property="catId" column="cat_id" />
        <result property="tnrId" column="tnr_id" />
        <result property="releaseDate" column="release_date" />
        <result property="releasePoint" column="release_point" />
        <result property="releaseStatus" column="release_status" />
        <result property="marked" column="marked" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatReleaseVo">
        select release_id, cat_id, tnr_id, release_date, release_point, release_status, marked, create_by, create_time, update_by, update_time, remark from cat_release
    </sql>

    <select id="selectCatReleaseById" parameterType="Long" resultMap="CatReleaseResult">
        <include refid="selectCatReleaseVo"/>
        where release_id = #{releaseId}
    </select>

    <select id="selectCatReleaseList" parameterType="CatRelease" resultMap="CatReleaseResult">
        <include refid="selectCatReleaseVo"/>
        <where>
            <if test="catId != null">AND cat_id = #{catId}</if>
            <if test="tnrId != null">AND tnr_id = #{tnrId}</if>
            <if test="releaseDate != null">AND release_date = #{releaseDate}</if>
            <if test="params.beginTime != null and params.beginTime != ''">AND date_format(release_date,'%y.%m.%d') &gt;= date_format(#{params.beginTime},'%y.%m.%d')</if>
            <if test="params.endTime != null and params.endTime != ''">AND date_format(release_date,'%y.%m.%d') &lt;= date_format(#{params.endTime},'%y.%m.%d')</if>
            <if test="releasePoint != null and releasePoint != ''">AND release_point = #{releasePoint}</if>
            <if test="releaseStatus != null and releaseStatus != ''">AND release_status = #{releaseStatus}</if>
            <if test="marked != null and marked != ''">AND marked = #{marked}</if>
            AND del_flag = '0'
        </where>
        order by release_id desc
    </select>

    <insert id="insertCatRelease" parameterType="CatRelease" useGeneratedKeys="true" keyProperty="releaseId">
        insert into cat_release (
            <if test="catId != null">cat_id,</if>
            <if test="tnrId != null">tnr_id,</if>
            <if test="releaseDate != null">release_date,</if>
            <if test="releasePoint != null">release_point,</if>
            <if test="releaseStatus != null">release_status,</if>
            <if test="marked != null">marked,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="catId != null">#{catId},</if>
            <if test="tnrId != null">#{tnrId},</if>
            <if test="releaseDate != null">#{releaseDate},</if>
            <if test="releasePoint != null">#{releasePoint},</if>
            <if test="releaseStatus != null">#{releaseStatus},</if>
            <if test="marked != null">#{marked},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatRelease" parameterType="CatRelease">
        update cat_release
        <set>
            <if test="catId != null">cat_id = #{catId},</if>
            <if test="tnrId != null">tnr_id = #{tnrId},</if>
            <if test="releaseDate != null">release_date = #{releaseDate},</if>
            <if test="releasePoint != null and releasePoint != ''">release_point = #{releasePoint},</if>
            <if test="releaseStatus != null and releaseStatus != ''">release_status = #{releaseStatus},</if>
            <if test="marked != null and marked != ''">marked = #{marked},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where release_id = #{releaseId}
    </update>

    <delete id="deleteCatReleaseById" parameterType="Long">
        update cat_release set del_flag = '2' where release_id = #{releaseId}
    </delete>

    <delete id="deleteCatReleaseByIds" parameterType="Long">
        update cat_release set del_flag = '2' where release_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
