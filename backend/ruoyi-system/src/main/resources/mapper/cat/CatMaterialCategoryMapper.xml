<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatMaterialCategoryMapper">

    <resultMap type="CatMaterialCategory" id="CatMaterialCategoryResult">
        <result property="categoryId" column="category_id" />
        <result property="categoryName" column="category_name" />
        <result property="orderNum" column="order_num" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatMaterialCategoryVo">
        select category_id, category_name, order_num, status, create_by, create_time, update_by, update_time, remark from cat_material_category
    </sql>

    <select id="selectCatMaterialCategoryById" parameterType="Long" resultMap="CatMaterialCategoryResult">
        <include refid="selectCatMaterialCategoryVo"/>
        where category_id = #{categoryId}
    </select>

    <select id="selectCatMaterialCategoryList" parameterType="CatMaterialCategory" resultMap="CatMaterialCategoryResult">
        <include refid="selectCatMaterialCategoryVo"/>
        <where>
            <if test="categoryName != null and categoryName != ''">AND category_name = #{categoryName}</if>
            <if test="orderNum != null">AND order_num = #{orderNum}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            AND del_flag = '0'
        </where>
        order by category_id desc
    </select>

    <insert id="insertCatMaterialCategory" parameterType="CatMaterialCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into cat_material_category (
            <if test="categoryName != null">category_name,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="categoryName != null">#{categoryName},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatMaterialCategory" parameterType="CatMaterialCategory">
        update cat_material_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteCatMaterialCategoryById" parameterType="Long">
        update cat_material_category set del_flag = '2' where category_id = #{categoryId}
    </delete>

    <delete id="deleteCatMaterialCategoryByIds" parameterType="Long">
        update cat_material_category set del_flag = '2' where category_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
