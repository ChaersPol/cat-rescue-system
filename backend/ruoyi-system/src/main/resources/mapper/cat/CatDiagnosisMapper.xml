<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatDiagnosisMapper">

    <resultMap type="CatDiagnosis" id="CatDiagnosisResult">
        <result property="diagnosisId" column="diagnosis_id" />
        <result property="catId" column="cat_id" />
        <result property="baseId" column="base_id" />
        <result property="visitDate" column="visit_date" />
        <result property="doctor" column="doctor" />
        <result property="symptoms" column="symptoms" />
        <result property="diagnosisResult" column="diagnosis_result" />
        <result property="checkItems" column="check_items" />
        <result property="medicalAdvice" column="medical_advice" />
        <result property="checkPhotos" column="check_photos" />
        <result property="correctionNote" column="correction_note" />
        <result property="correctionBy" column="correction_by" />
        <result property="correctionTime" column="correction_time" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatDiagnosisVo">
        select diagnosis_id, cat_id, base_id, visit_date, doctor, symptoms, diagnosis_result, check_items, medical_advice, check_photos,
               correction_note, correction_by, correction_time, create_by, create_time, update_by, update_time, remark from cat_diagnosis
    </sql>

    <select id="selectCatDiagnosisById" parameterType="Long" resultMap="CatDiagnosisResult">
        <include refid="selectCatDiagnosisVo"/>
        where diagnosis_id = #{diagnosisId}
    </select>

    <select id="selectCatDiagnosisList" parameterType="CatDiagnosis" resultMap="CatDiagnosisResult">
        <include refid="selectCatDiagnosisVo"/>
        <where>
            <if test="catId != null">AND cat_id = #{catId}</if>
            <if test="baseId != null">AND base_id = #{baseId}</if>
            <if test="visitDate != null">AND visit_date = #{visitDate}</if>
            <if test="params.beginTime != null and params.beginTime != ''">AND date_format(visit_date,'%y.%m.%d') &gt;= date_format(#{params.beginTime},'%y.%m.%d')</if>
            <if test="params.endTime != null and params.endTime != ''">AND date_format(visit_date,'%y.%m.%d') &lt;= date_format(#{params.endTime},'%y.%m.%d')</if>
            <if test="doctor != null and doctor != ''">AND doctor = #{doctor}</if>
            <if test="symptoms != null and symptoms != ''">AND symptoms = #{symptoms}</if>
            <if test="diagnosisResult != null and diagnosisResult != ''">AND diagnosis_result = #{diagnosisResult}</if>
            <if test="checkItems != null and checkItems != ''">AND check_items = #{checkItems}</if>
            <if test="medicalAdvice != null and medicalAdvice != ''">AND medical_advice = #{medicalAdvice}</if>
            <if test="checkPhotos != null and checkPhotos != ''">AND check_photos = #{checkPhotos}</if>
            AND del_flag = '0'
        </where>
        order by diagnosis_id desc
    </select>

    <insert id="insertCatDiagnosis" parameterType="CatDiagnosis" useGeneratedKeys="true" keyProperty="diagnosisId">
        insert into cat_diagnosis (
            <if test="catId != null">cat_id,</if>
            <if test="baseId != null">base_id,</if>
            <if test="visitDate != null">visit_date,</if>
            <if test="doctor != null">doctor,</if>
            <if test="symptoms != null">symptoms,</if>
            <if test="diagnosisResult != null">diagnosis_result,</if>
            <if test="checkItems != null">check_items,</if>
            <if test="medicalAdvice != null">medical_advice,</if>
            <if test="checkPhotos != null">check_photos,</if>
            <if test="correctionNote != null">correction_note,</if>
            <if test="correctionBy != null">correction_by,</if>
            <if test="correctionTime != null">correction_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="catId != null">#{catId},</if>
            <if test="baseId != null">#{baseId},</if>
            <if test="visitDate != null">#{visitDate},</if>
            <if test="doctor != null">#{doctor},</if>
            <if test="symptoms != null">#{symptoms},</if>
            <if test="diagnosisResult != null">#{diagnosisResult},</if>
            <if test="checkItems != null">#{checkItems},</if>
            <if test="medicalAdvice != null">#{medicalAdvice},</if>
            <if test="checkPhotos != null">#{checkPhotos},</if>
            <if test="correctionNote != null">#{correctionNote},</if>
            <if test="correctionBy != null">#{correctionBy},</if>
            <if test="correctionTime != null">#{correctionTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatDiagnosis" parameterType="CatDiagnosis">
        update cat_diagnosis
        <set>
            <if test="catId != null">cat_id = #{catId},</if>
            <if test="baseId != null">base_id = #{baseId},</if>
            <if test="visitDate != null">visit_date = #{visitDate},</if>
            <if test="doctor != null and doctor != ''">doctor = #{doctor},</if>
            <if test="symptoms != null and symptoms != ''">symptoms = #{symptoms},</if>
            <if test="diagnosisResult != null and diagnosisResult != ''">diagnosis_result = #{diagnosisResult},</if>
            <if test="checkItems != null and checkItems != ''">check_items = #{checkItems},</if>
            <if test="medicalAdvice != null and medicalAdvice != ''">medical_advice = #{medicalAdvice},</if>
            <if test="checkPhotos != null and checkPhotos != ''">check_photos = #{checkPhotos},</if>
            <if test="correctionNote != null and correctionNote != ''">correction_note = #{correctionNote},</if>
            <if test="correctionBy != null and correctionBy != ''">correction_by = #{correctionBy},</if>
            <if test="correctionTime != null">correction_time = #{correctionTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where diagnosis_id = #{diagnosisId}
    </update>

    <delete id="deleteCatDiagnosisById" parameterType="Long">
        update cat_diagnosis set del_flag = '2' where diagnosis_id = #{diagnosisId}
    </delete>

    <delete id="deleteCatDiagnosisByIds" parameterType="Long">
        update cat_diagnosis set del_flag = '2' where diagnosis_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
