<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatWardMapper">

    <resultMap type="CatWard" id="CatWardResult">
        <result property="wardId" column="ward_id" />
        <result property="baseId" column="base_id" />
        <result property="wardName" column="ward_name" />
        <result property="wardType" column="ward_type" />
        <result property="orderNum" column="order_num" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatWardVo">
        select ward_id, base_id, ward_name, ward_type, order_num, status, create_by, create_time, update_by, update_time, remark from cat_ward
    </sql>

    <select id="selectCatWardById" parameterType="Long" resultMap="CatWardResult">
        <include refid="selectCatWardVo"/>
        where ward_id = #{wardId}
    </select>

    <select id="selectCatWardList" parameterType="CatWard" resultMap="CatWardResult">
        <include refid="selectCatWardVo"/>
        <where>
            <if test="baseId != null">AND base_id = #{baseId}</if>
            <if test="wardName != null and wardName != ''">AND ward_name = #{wardName}</if>
            <if test="wardType != null and wardType != ''">AND ward_type = #{wardType}</if>
            <if test="orderNum != null">AND order_num = #{orderNum}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            AND del_flag = '0'
        </where>
        order by ward_id desc
    </select>

    <insert id="insertCatWard" parameterType="CatWard" useGeneratedKeys="true" keyProperty="wardId">
        insert into cat_ward (
            <if test="baseId != null">base_id,</if>
            <if test="wardName != null">ward_name,</if>
            <if test="wardType != null">ward_type,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="baseId != null">#{baseId},</if>
            <if test="wardName != null">#{wardName},</if>
            <if test="wardType != null">#{wardType},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatWard" parameterType="CatWard">
        update cat_ward
        <set>
            <if test="baseId != null">base_id = #{baseId},</if>
            <if test="wardName != null and wardName != ''">ward_name = #{wardName},</if>
            <if test="wardType != null and wardType != ''">ward_type = #{wardType},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where ward_id = #{wardId}
    </update>

    <delete id="deleteCatWardById" parameterType="Long">
        update cat_ward set del_flag = '2' where ward_id = #{wardId}
    </delete>

    <delete id="deleteCatWardByIds" parameterType="Long">
        update cat_ward set del_flag = '2' where ward_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
