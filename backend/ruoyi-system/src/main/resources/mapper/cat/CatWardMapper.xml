<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatWardMapper">

    <resultMap type="CatWard" id="CatWardResult">
        <result property="wardId" column="ward_id" />
        <result property="baseId" column="base_id" />
        <result property="wardName" column="ward_name" />
        <result property="wardTypeId" column="ward_type_id" />
        <result property="wardType" column="ward_type" />
        <result property="orderNum" column="order_num" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatWardVo">
        select ward_id, base_id, ward_name, ward_type_id, ward_type, order_num, status, del_flag, create_by, create_time, update_by, update_time, remark from cat_ward
    </sql>

    <select id="selectCatWardById" parameterType="Long" resultMap="CatWardResult">
        <include refid="selectCatWardVo"/>
        where ward_id = #{wardId}
    </select>

    <select id="selectCatWardList" parameterType="CatWard" resultMap="CatWardResult">
        <include refid="selectCatWardVo"/>
        <where>
            <if test="baseId != null">AND base_id = #{baseId}</if>
            <if test="wardName != null and wardName != ''">AND ward_name like concat('%', #{wardName}, '%')</if>
            <if test="wardTypeId != null">AND ward_type_id = #{wardTypeId}</if>
            <if test="wardType != null and wardType != ''">AND ward_type = #{wardType}</if>
            <if test="orderNum != null">AND order_num = #{orderNum}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <!-- 默认只查有效病房；档案列表回显历史病房名时传 includeDeleted=true 取全量 -->
            <if test="includeDeleted == null or includeDeleted == false">AND del_flag = '0'</if>
        </where>
        order by base_id asc, order_num asc, ward_id asc
    </select>

    <insert id="insertCatWard" parameterType="CatWard" useGeneratedKeys="true" keyProperty="wardId">
        insert into cat_ward (
            <if test="baseId != null">base_id,</if>
            <if test="wardName != null">ward_name,</if>
            <if test="wardTypeId != null">ward_type_id,</if>
            <if test="wardType != null">ward_type,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="baseId != null">#{baseId},</if>
            <if test="wardName != null">#{wardName},</if>
            <if test="wardTypeId != null">#{wardTypeId},</if>
            <if test="wardType != null">#{wardType},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatWard" parameterType="CatWard">
        update cat_ward
        <set>
            <if test="baseId != null">base_id = #{baseId},</if>
            <if test="wardName != null and wardName != ''">ward_name = #{wardName},</if>
            <if test="wardTypeId != null">ward_type_id = #{wardTypeId},</if>
            <if test="wardType != null and wardType != ''">ward_type = #{wardType},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where ward_id = #{wardId}
    </update>

    <update id="updateWardTypeNameByTypeId">
        update cat_ward set ward_type = #{typeName}
         where ward_type_id = #{typeId} and del_flag = '0'
    </update>

    <delete id="deleteCatWardById" parameterType="Long">
        update cat_ward set del_flag = '2' where ward_id = #{wardId}
    </delete>

    <delete id="deleteCatWardByIds" parameterType="Long">
        update cat_ward set del_flag = '2' where ward_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <!-- 删除病房前的占用校验：只返回还挂着在册猫咪的病房（无猫的病房不出现） -->
    <select id="selectWardCatCounts" resultType="java.util.HashMap">
        select w.ward_id as wardId, w.ward_name as wardName, count(p.cat_id) as catCount
          from cat_ward w
          join cat_profile p on p.ward_id = w.ward_id and p.del_flag = '0'
         where w.ward_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
         group by w.ward_id, w.ward_name
    </select>

    <!-- 前端删除确认用：所选病房逐个给出在册猫数量，0 只的也要返回（用于区分「可删」与「不可删」） -->
    <select id="selectWardCatCountList" resultType="java.util.HashMap">
        select w.ward_id as wardId, w.ward_name as wardName,
               (select count(1) from cat_profile p where p.ward_id = w.ward_id and p.del_flag = '0') as catCount
          from cat_ward w
         where w.ward_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
         order by w.base_id asc, w.order_num asc, w.ward_id asc
    </select>

    <!-- 病房删除时连带清掉授权，避免助理那边残留指向已删病房的行 -->
    <delete id="deleteWardAuthByWardIds" parameterType="Long">
        delete from cat_ward_auth where ward_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
