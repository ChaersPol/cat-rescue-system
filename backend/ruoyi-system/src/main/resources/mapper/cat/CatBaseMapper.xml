<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatBaseMapper">

    <resultMap type="CatBase" id="CatBaseResult">
        <result property="baseId" column="base_id" />
        <result property="baseName" column="base_name" />
        <result property="baseType" column="base_type" />
        <result property="leader" column="leader" />
        <result property="phone" column="phone" />
        <result property="address" column="address" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatBaseVo">
        select base_id, base_name, base_type, leader, phone, address, status, create_by, create_time, update_by, update_time, remark from cat_base
    </sql>

    <select id="selectCatBaseById" parameterType="Long" resultMap="CatBaseResult">
        <include refid="selectCatBaseVo"/>
        where base_id = #{baseId}
    </select>

    <select id="selectCatBaseList" parameterType="CatBase" resultMap="CatBaseResult">
        <include refid="selectCatBaseVo"/>
        <where>
            <if test="baseName != null and baseName != ''">AND base_name = #{baseName}</if>
            <if test="baseType != null and baseType != ''">AND base_type = #{baseType}</if>
            <if test="leader != null and leader != ''">AND leader = #{leader}</if>
            <if test="phone != null and phone != ''">AND phone = #{phone}</if>
            <if test="address != null and address != ''">AND address = #{address}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            AND del_flag = '0'
        </where>
        order by base_id desc
    </select>

    <insert id="insertCatBase" parameterType="CatBase" useGeneratedKeys="true" keyProperty="baseId">
        insert into cat_base (
            <if test="baseName != null">base_name,</if>
            <if test="baseType != null">base_type,</if>
            <if test="leader != null">leader,</if>
            <if test="phone != null">phone,</if>
            <if test="address != null">address,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="baseName != null">#{baseName},</if>
            <if test="baseType != null">#{baseType},</if>
            <if test="leader != null">#{leader},</if>
            <if test="phone != null">#{phone},</if>
            <if test="address != null">#{address},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatBase" parameterType="CatBase">
        update cat_base
        <set>
            <if test="baseName != null and baseName != ''">base_name = #{baseName},</if>
            <if test="baseType != null and baseType != ''">base_type = #{baseType},</if>
            <if test="leader != null and leader != ''">leader = #{leader},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where base_id = #{baseId}
    </update>

    <delete id="deleteCatBaseById" parameterType="Long">
        update cat_base set del_flag = '2' where base_id = #{baseId}
    </delete>

    <delete id="deleteCatBaseByIds" parameterType="Long">
        update cat_base set del_flag = '2' where base_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
