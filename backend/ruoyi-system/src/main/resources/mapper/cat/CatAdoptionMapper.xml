<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cat.mapper.CatAdoptionMapper">

    <resultMap type="CatAdoption" id="CatAdoptionResult">
        <result property="adoptionId" column="adoption_id" />
        <result property="catId" column="cat_id" />
        <result property="adopterName" column="adopter_name" />
        <result property="adopterPhone" column="adopter_phone" />
        <result property="adopterAddress" column="adopter_address" />
        <result property="adoptionDate" column="adoption_date" />
        <result property="agreementUrl" column="agreement_url" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCatAdoptionVo">
        select adoption_id, cat_id, adopter_name, adopter_phone, adopter_address, adoption_date, agreement_url, create_by, create_time, update_by, update_time, remark from cat_adoption
    </sql>

    <select id="selectCatAdoptionById" parameterType="Long" resultMap="CatAdoptionResult">
        <include refid="selectCatAdoptionVo"/>
        where adoption_id = #{adoptionId}
    </select>

    <select id="selectCatAdoptionList" parameterType="CatAdoption" resultMap="CatAdoptionResult">
        <include refid="selectCatAdoptionVo"/>
        <where>
            <if test="catId != null">AND cat_id = #{catId}</if>
            <if test="adopterName != null and adopterName != ''">AND adopter_name like concat('%', #{adopterName}, '%')</if>
            <if test="adopterPhone != null and adopterPhone != ''">AND adopter_phone like concat('%', #{adopterPhone}, '%')</if>
            <if test="adopterAddress != null and adopterAddress != ''">AND adopter_address = #{adopterAddress}</if>
            <if test="adoptionDate != null">AND adoption_date = #{adoptionDate}</if>
            <if test="agreementUrl != null and agreementUrl != ''">AND agreement_url = #{agreementUrl}</if>
            AND del_flag = '0'
        </where>
        order by adoption_id desc
    </select>

    <insert id="insertCatAdoption" parameterType="CatAdoption" useGeneratedKeys="true" keyProperty="adoptionId">
        insert into cat_adoption (
            <if test="catId != null">cat_id,</if>
            <if test="adopterName != null">adopter_name,</if>
            <if test="adopterPhone != null">adopter_phone,</if>
            <if test="adopterAddress != null">adopter_address,</if>
            <if test="adoptionDate != null">adoption_date,</if>
            <if test="agreementUrl != null">agreement_url,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="catId != null">#{catId},</if>
            <if test="adopterName != null">#{adopterName},</if>
            <if test="adopterPhone != null">#{adopterPhone},</if>
            <if test="adopterAddress != null">#{adopterAddress},</if>
            <if test="adoptionDate != null">#{adoptionDate},</if>
            <if test="agreementUrl != null">#{agreementUrl},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCatAdoption" parameterType="CatAdoption">
        update cat_adoption
        <set>
            <if test="catId != null">cat_id = #{catId},</if>
            <if test="adopterName != null and adopterName != ''">adopter_name = #{adopterName},</if>
            <if test="adopterPhone != null and adopterPhone != ''">adopter_phone = #{adopterPhone},</if>
            <if test="adopterAddress != null and adopterAddress != ''">adopter_address = #{adopterAddress},</if>
            <if test="adoptionDate != null">adoption_date = #{adoptionDate},</if>
            <!-- 允许写入空串：用户在页面上删掉协议后要能把 agreement_url 清空，
                 否则数据库仍指向一个已被物理删除的文件，预览必然空白 -->
            <if test="agreementUrl != null">agreement_url = #{agreementUrl},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where adoption_id = #{adoptionId}
    </update>

    <delete id="deleteCatAdoptionById" parameterType="Long">
        update cat_adoption set del_flag = '2' where adoption_id = #{adoptionId}
    </delete>

    <delete id="deleteCatAdoptionByIds" parameterType="Long">
        update cat_adoption set del_flag = '2' where adoption_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
